# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# Strong random password for PostgreSQL
POSTGRES_PASSWORD=change_me_to_a_strong_password

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_secret_key

# Comma-separated list of allowed Google account emails
# Leave empty to allow anyone with a Google account to sign in
ALLOWED_EMAILS=guosheng5566@gmail.com
