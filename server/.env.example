# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# Strong random password for PostgreSQL
POSTGRES_PASSWORD=change_me_to_a_strong_password

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_secret_key

# Comma-separated list of allowed Google account emails
# Leave empty to allow anyone with a Google account to sign in
# Comma-separated list of allowed Google account emails
# Leave empty to allow anyone with a Google account to sign in
ALLOWED_EMAILS=guosheng5566@gmail.com

# (Optional) Card OCR — enables business-card auto-recognition in 名片夹.
# Uses any OpenAI-compatible vision endpoint (default: Alibaba Model Studio).
# Without OCR_API_KEY the 名片夹 app still works, but you fill card fields manually.
# OCR_API_KEY=sk-...
# OCR_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# OCR_MODEL=qwen3-vl-flash
# 模型 id 会被下线（qwen3-vl-flash 就开始回 404 Model not exist）。留空时服务器会
# 依次试 qwen3-vl-plus / qwen3-vl-flash / qwen-vl-max-latest / qwen-vl-plus-latest /
# qwen-vl-max / qwen-vl-plus，用上哪个就记住哪个。都不行的话 App 里的报错会列出
# 你账号下实际可用的模型名，照着填这里即可（逗号分隔可以给多个备选）。

# (Optional) AI tidy-up for voice notes (Siri/Shortcut quick-add): add Chinese
# punctuation & sentence breaks before saving. On automatically when OCR_API_KEY
# is set (reuses OCR_BASE_URL). Text model defaults to OCR_MODEL — override here
# with a cheaper text-only model if you like. Set QUICKADD_AI=off to disable.
# AI_TEXT_MODEL=qwen-flash
# QUICKADD_AI=off
